    "sheet": { "$type": "dimension", "$value": { "value": 28, "unit": "pt" } }
  },
  "route": {
    "activeWidth": { "$type": "dimension", "$value": { "value": 7, "unit": "pt" } },
    "casingWidth": { "$type": "dimension", "$value": { "value": 11, "unit": "pt" } },
    "alternativeWidth": { "$type": "dimension", "$value": { "value": 5, "unit": "pt" } },
    "navigationArrow": {
      "turnByTurnSize": { "$type": "dimension", "$value": { "value": 40, "unit": "pt" } },
      "browseSize": { "$type": "dimension", "$value": { "value": 32, "unit": "pt" } },
      "minimumSize": { "$type": "dimension", "$value": { "value": 24, "unit": "pt" } }
    }
  }
